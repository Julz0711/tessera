{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-agent/types/**/*.ts",
    ".next-agent/dev/types/**/*.ts",
    ".next-agent4/types/**/*.ts",
    ".next-agent4/dev/types/**/*.ts",
    ".next-agent3/types/**/*.ts",
    ".next-agent3/dev/types/**/*.ts",
    ".next-agent5/types/**/*.ts",
    ".next-agent5/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".data"
  ]
}
