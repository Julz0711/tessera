# Copy to .env and fill in what you need. Everything is optional for local play.

# Port for the combined web + game server (default 3000; the dev server picks the next free one).
# PORT=3000

# Product name shown in the UI (working title).
# NEXT_PUBLIC_APP_NAME=Tessera

# Signs guest cookies and Auth.js sessions. Generated automatically in .data/ if unset —
# set a long random value in production (e.g. `openssl rand -base64 32`).
# AUTH_SECRET=

# PostgreSQL enables profiles, game history, stats and game recovery after restarts.
# Local option: `npm run db:local` (embedded PostgreSQL), then `npm run db:push`.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/settlers

# OAuth sign-in (needs DATABASE_URL). Callback URLs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/discord
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=

# Behind a reverse proxy: trust X-Forwarded-For for rate limiting, and list extra allowed origins.
# TRUST_PROXY=1
# APP_URL=https://play.example.com
# ALLOWED_ORIGINS=https://play.example.com

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/settlers"