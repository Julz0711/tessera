{
  "name": "settlers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based 3D multiplayer strategy board game for friend groups (Tessera).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:privacy": "node scripts/test-privacy.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "privacy:delete": "tsx scripts/delete-personal-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "^8.5.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
